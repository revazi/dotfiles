#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'test-nvim: %s\n' "$*" >&2
  exit 1
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)

for command in git nvim tar tree-sitter; do
  command -v "$command" >/dev/null 2>&1 || fail "required command not found: $command"
done

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-nvim-test.XXXXXX")
tmp_dir=$(CDPATH='' cd -- "$tmp_dir" && pwd -P)
cleanup() {
  rm -rf "$tmp_dir" 2>/dev/null || rm -rf "$tmp_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Do not let caller-specific Neovim startup settings redirect or replace the
# staged canonical configuration. VIM and VIMRUNTIME must come from the tested
# Neovim installation rather than the caller's environment.
export NVIM_APPNAME=nvim
unset VIMINIT EXINIT VIM VIMRUNTIME

export HOME="$tmp_dir/home"
export XDG_CONFIG_HOME="$tmp_dir/xdg/config"
export XDG_DATA_HOME="$tmp_dir/xdg/data"
export XDG_STATE_HOME="$tmp_dir/xdg/state"
export XDG_CACHE_HOME="$tmp_dir/xdg/cache"
export DOTFILES_NVIM_SMOKE=1
export DOTFILES_NVIM_SOURCE="$repo_root/config/nvim"
export GIT_TERMINAL_PROMPT=0

mkdir -p "$HOME" "$XDG_CONFIG_HOME/nvim" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
tar -C "$repo_root/config/nvim" -cf - . | tar -C "$XDG_CONFIG_HOME/nvim" -xf -

lazy_commit=$(
  awk -F '"' '/"lazy.nvim"/ { for (i = 1; i <= NF; i++) if ($i == "commit") { print $(i + 2); exit } }' \
    "$XDG_CONFIG_HOME/nvim/lazy-lock.json"
)
[[ "$lazy_commit" =~ ^[0-9a-f]{40}$ ]] || fail "could not read the lazy.nvim commit from lazy-lock.json"

lazy_dir="$XDG_DATA_HOME/nvim/lazy/lazy.nvim"
mkdir -p "$lazy_dir"
git -C "$lazy_dir" init -q
git -C "$lazy_dir" remote add origin https://github.com/folke/lazy.nvim.git
git -C "$lazy_dir" fetch -q --depth=1 origin "$lazy_commit"
git -C "$lazy_dir" checkout -q -B main FETCH_HEAD
[[ $(git -C "$lazy_dir" rev-parse HEAD) == "$lazy_commit" ]] || fail "lazy.nvim checkout does not match lazy-lock.json"

unsupported_log="$tmp_dir/unsupported.log"
if ! nvim --headless \
  --cmd 'lua vim.g.revaz_preflight_overrides = { version = { 0, 11, 9 } }' \
  -c 'lua assert(package.loaded["revaz.bigfile"] == nil); assert(vim.fn.exists(":ConfigHealth") == 0); vim.cmd("qa!")' \
  >"$unsupported_log" 2>&1; then
  cat "$unsupported_log" >&2
  fail "unsupported-version simulation failed"
fi
unsupported_message='This configuration requires Neovim 0.12.0 or newer (found 0.11.9). Upgrade Neovim, then restart; configuration loading was stopped.'
[[ $(grep -Foc "$unsupported_message" "$unsupported_log") -eq 1 ]] || fail "unsupported version did not produce exactly one actionable guard message"
if grep -Eiq 'module .* not found|stack traceback|plugin.*error' "$unsupported_log"; then
  cat "$unsupported_log" >&2
  fail "unsupported version produced cascading configuration errors"
fi

missing_git_data="$tmp_dir/missing-git/data"
missing_git_log="$tmp_dir/missing-git.log"
if ! XDG_DATA_HOME="$missing_git_data" nvim --headless \
  --cmd 'lua vim.g.revaz_preflight_overrides = { executables = { git = false } }' \
  -c 'lua assert(vim.fn.exists(":ConfigHealth") == 2); assert(package.loaded["revaz.core.options"] == nil); vim.cmd("ConfigHealth"); assert(vim.wait(10000, function() return table.concat(vim.api.nvim_buf_get_lines(0, 0, -1, false), "\n"):find("Required bootstrap/runtime tools", 1, true) ~= nil end, 100)); vim.cmd("qa!")' \
  >"$missing_git_log" 2>&1; then
  cat "$missing_git_log" >&2
  fail "missing-Git bootstrap simulation failed"
fi
grep -Fq 'lazy.nvim bootstrap skipped' "$missing_git_log" || fail "missing Git did not report the skipped lazy.nvim bootstrap"
[[ ! -e "$missing_git_data/nvim/lazy/lazy.nvim" ]] || fail "lazy.nvim bootstrap was attempted without Git"

printf 'Running isolated Neovim smoke tests (temporary data: %s)\n' "$tmp_dir"
log_file="$tmp_dir/neovim.log"
if ! nvim --headless -c "lua dofile([[$repo_root/scripts/nvim-smoke.lua]])" >"$log_file" 2>&1; then
  printf 'Neovim smoke test output (last 200 lines):\n' >&2
  tail -n 200 "$log_file" >&2
  exit 1
fi

grep -o 'Neovim smoke tests passed ([^)]*verified)' "$log_file" | tail -n 1
